# cmake/EmbedBinaryData.cmake
# =============================================================================
# Read a binary file and emit a C++ source file containing the bytes as a
# `const unsigned char[]` array plus a `const std::size_t` size variable.
#
# Pure CMake — no Python, xxd, objcopy, or other host tool required.  Works
# on every platform CMake supports (macOS, Linux, Windows, BSD).
#
# Usage (from a parent CMakeLists.txt or via cmake -P):
#
#   cmake -DINPUT=<binary_file>              \
#         -DOUTPUT=<generated_cpp_file>       \
#         -DSYMBOL=<symbol_name>              \
#         -P cmake/EmbedBinaryData.cmake
#
# The generated C++ file exports two symbols in an anonymous namespace:
#
#   namespace <ns> {
#     extern const unsigned char <symbol>[];
#     extern const std::size_t   <symbol>Size;
#   }
#
# Example:
#   cmake -DINPUT=lucide.ttf          \
#         -DOUTPUT=lucide_font_data.cpp \
#         -DSYMBOL=kLucideTtf          \
#         -DNS=fluffy                   \
#         -P cmake/EmbedBinaryData.cmake
# =============================================================================

if(NOT INPUT OR NOT OUTPUT OR NOT SYMBOL)
    message(FATAL_ERROR
        "Usage: cmake -DINPUT=<file> -DOUTPUT=<file> -DSYMBOL=<name> "
        "-DNS=<namespace> -P EmbedBinaryData.cmake")
endif()

if(NOT EXISTS "${INPUT}")
    message(FATAL_ERROR "Input file does not exist: ${INPUT}")
endif()

# Read the entire binary file as a hex string.
file(READ "${INPUT}" _hex HEX)
file(SIZE "${INPUT}" _size)

# Convert "AABBCCDD..." to "0xAA,0xBB,0xCC,0xDD,..."
string(REGEX REPLACE "(..)" "0x\\1," _hex "${_hex}")
# Strip the trailing comma
string(REGEX REPLACE ",$" "" _hex "${_hex}")

# Emit the C++ source file.
file(WRITE "${OUTPUT}"
    "// Generated by CMake -- do not edit\n"
    "// Source: ${INPUT}\n"
    "#include <cstddef>\n"
    "#include <cstdint>\n"
    "namespace ${NS} {\n"
    "extern const unsigned char ${SYMBOL}[] = {\n"
    "${_hex}\n"
    "};\n"
    "extern const std::size_t ${SYMBOL}Size = ${_size};\n"
    "}\n"
)

message(STATUS "Embedded ${_size} bytes from ${INPUT} into ${OUTPUT}")
