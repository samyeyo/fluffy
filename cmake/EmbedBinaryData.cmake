# cmake -DINPUT=<file> -DOUTPUT=<file> -DSYMBOL=<name> -DNS=<namespace> -P EmbedBinaryData.cmake

if(NOT INPUT OR NOT OUTPUT OR NOT SYMBOL)
    message(FATAL_ERROR
        "Usage: cmake -DINPUT=<file> -DOUTPUT=<file> -DSYMBOL=<name> "
        "-DNS=<namespace> -P EmbedBinaryData.cmake")
endif()

if(NOT EXISTS "${INPUT}")
    message(FATAL_ERROR "Input file does not exist: ${INPUT}")
endif()

file(READ "${INPUT}" _hex HEX)
file(SIZE "${INPUT}" _size)

string(REGEX REPLACE "(..)" "0x\\1," _hex "${_hex}")
string(REGEX REPLACE ",$" "" _hex "${_hex}")

file(WRITE "${OUTPUT}"
    "// Generated by CMake -- do not edit\n"
    "// Source: ${INPUT}\n"
    "#include <cstddef>\n"
    "#include <cstdint>\n"
    "namespace ${NS} {\n"
    "extern const unsigned char ${SYMBOL}[] = {\n"
    "${_hex}\n"
    "};\n"
    "extern const std::size_t ${SYMBOL}Size = ${_size};\n"
    "}\n"
)

message(STATUS "Embedded ${_size} bytes from ${INPUT} into ${OUTPUT}")
